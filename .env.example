# Copy this file to .env (same folder) and fill in your own values.
# Never commit or share .env.

# Portkey API key for the chatbot
PORTKEY_API_KEY=your-portkey-api-key

# Signs login cookies. Any long random string.
SESSION_SECRET=any-long-random-string

# Optional: use a database somewhere other than data/campus_customs.db
# CAMPUS_DB_PATH=C:/path/to/campus_customs.db

# Optional: these are the defaults
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# PORTKEY_MODEL=gpt-5.6-luna
